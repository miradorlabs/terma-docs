  "keyFeatures": [
    "Session replay with full message, tool call, and cost timeline",
    "Codebase burn map showing AI activity by file",
    "Multi-provider entitlement tracking (subscriptions, metered, prepaid, keys)",
    "Session-to-commit attribution via git commit trailers",
    "Team breakdowns by person, model, provider, and harness",
    "Dev-time and run-time budgets with Slack notifications and hard caps",
    "Agent wallet management and x402 on-chain payment reconciliation",
    "Production correlation linking AI-assisted changes to outcome metrics",
    "Cross-rail findings for redundant spend and throttle detection",
    "CLI for terminal-based querying and repository onboarding"
  ],
