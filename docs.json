{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Terma",
  "colors": {
    "primary": "#6347e0",
    "light": "#ffffff"
  },
  "favicon": {
    "light": "/images/favicon.svg",
    "dark": "/images/favicon.svg"
  },
  "logo": {
    "light": "/images/favicon.svg",
    "dark": "/images/favicon.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@terma.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign Up Free",
      "href": "https://terma.ai/sign-up"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "account-setup"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/overview",
              "concepts/sessions",
              "concepts/attribution",
              "concepts/entitlements",
              "concepts/privacy"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/claude-code",
              "integrations/codex",
              "integrations/cursor",
              "integrations/opencode",
              "integrations/antigravity",
              "integrations/openrouter"
            ]
          },
          {
            "group": "Dashboard",
            "pages": [
              "dashboard/overview",
              "dashboard/session-replay",
              "dashboard/users",
              "dashboard/burn-map",
              "dashboard/pull-requests",
              "dashboard/models",
              "dashboard/metrics",
              "dashboard/skills-mcp",
              "dashboard/settings"
            ]
          }
        ]
      },
      {
        "tab": "CLI Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "cli/overview",
              "cli/installation"
            ]
          },
          {
            "group": "Onboarding",
            "pages": [
              "cli/setup",
              "cli/install",
              "cli/status",
              "cli/doctor",
              "cli/update"
            ]
          },
          {
            "group": "Insights",
            "pages": [
              "cli/usage",
              "cli/sessions",
              "cli/principals"
            ]
          },
          {
            "group": "Account and configuration",
            "pages": [
              "cli/account",
              "cli/project",
              "cli/configuration"
            ]
          },
          {
            "group": "Advanced",
            "pages": [
              "cli/harnesses",
              "cli/spool"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/dashboard/breakdowns",
      "destination": "/dashboard/users"
    },
    {
      "source": "/dashboard/budgets",
      "destination": "/dashboard/overview"
    },
    {
      "source": "/dashboard/production",
      "destination": "/dashboard/overview"
    }
  ],
  "footer": {
    "socials": {
      "github": "https://github.com/miradorlabs"
    }
  },
  "appearance": {
    "default": "light"
  }
}
